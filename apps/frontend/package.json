{
  "name": "client",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "npm run dev",
    "typecheck": "react-router typegen && tsc",
    "generate:types": "npm run generate:types --workspace=@mah/api",
    "generate:types:local": "npm run generate:types:local --workspace=@mah/api",
    "generate:types:prod": "npm run generate:types:prod --workspace=@mah/api",
    "dev:with-types": "npm run generate:types:local && npm run dev",
    "generate:types:safe": "npm run generate:types --workspace=@mah/api 2>/dev/null || true",
    "dev:safe": "npm run generate:types:safe && npm run dev",
    "generate:zod": "npm run generate:zod --workspace=@mah/api",
    "format": "prettier --write \"app/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-router/node": "^7.9.2",
    "@react-router/serve": "^7.9.2",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@vercel/react-router": "^1.2.4",
    "@zodios/core": "^10.9.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express-useragent": "^1.0.15",
    "framer-motion": "^12.23.23",
    "isbot": "^5.1.31",
    "jose": "^6.1.3",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.69.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.2",
    "react-virtualized": "^9.22.6",
    "react-window": "^2.2.3",
    "react-window-infinite-loader": "^2.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "@mah/api": "*",
    "@mah/client": "*"
  },
  "devDependencies": {
    "@netlify/vite-plugin": "^2.7.19",
    "@netlify/vite-plugin-react-router": "^1.0.1",
    "@react-router/dev": "^7.9.2",
    "@tailwindcss/vite": "^4.1.13",
    "@types/express-useragent": "^1.0.5",
    "@types/node": "^22",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-virtualized": "^9.22.3",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
