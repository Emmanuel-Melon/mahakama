{
  "name": "@mah/api",
  "version": "1.0.0",
  "description": "Frontend API client consumed from the Mahakama backend OpenAPI spec.",
  "scripts": {
    "generate:types": "openapi-typescript $VITE_API_BASE_URL/api-docs.json -o src/generated/api.types.ts || echo 'Type generation failed - check if backend is running'",
    "generate:types:local": "VITE_API_BASE_URL=http://localhost:3000 npm run generate:types",
    "generate:types:prod": "VITE_API_BASE_URL=https://mahakama-api-production.up.railway.app npm run generate:types",
    "generate:zod": "openapi-zod-client http://localhost:3000/api-docs.json --output src/generated/api.schemas.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api.utils": "./src/api/api.utils.ts",
    "./api.types": "./src/api/api.types.ts",
    "./api.routes": "./src/api.routes.ts",
    "./generated/api.types": "./src/generated/api.types.ts",
    "./generated/api.schemas": "./src/generated/api.schemas.ts",
    "./clients/auth.api": "./src/clients/auth.api.ts",
    "./clients/chat.api": "./src/clients/chat.api.ts",
    "./clients/documents.api": "./src/clients/documents.api.ts",
    "./clients/inference.api": "./src/clients/inference.api.ts",
    "./clients/lawyers.api": "./src/clients/lawyers.api.ts",
    "./clients/notifications.api": "./src/clients/notifications.api.ts",
    "./clients/services.api": "./src/clients/services.api.ts",
    "./clients/users.api": "./src/clients/users.api.ts",
    "./hooks/use-auth": "./src/hooks/use-auth.ts",
    "./hooks/use-chats": "./src/hooks/chats/use-chats.ts",
    "./hooks/use-chats-sse": "./src/hooks/chats/use-chats.sse.ts",
    "./hooks/use-documents": "./src/hooks/use-documents.ts",
    "./hooks/use-lawyers": "./src/hooks/use-lawyers.tsx",
    "./hooks/user-documents/use-user-documents": "./src/hooks/user-documents/use-user-documents.ts",
    "./hooks/use-notifications": "./src/hooks/use-notifications.ts",
    "./hooks/use-services": "./src/hooks/use-services.ts",
    "./hooks/use-users": "./src/hooks/use-users.ts",
    "./react-query": "./src/react-query/index.ts",
    "./hooks/use-upload-manager": "./src/hooks/use-upload-manager.ts",
    "./hooks/documents/use-documents.sse": "./src/hooks/documents/use-documents.sse.ts",
    "./hooks/user-documents/use-user-documents.sse": "./src/hooks/user-documents/use-user-documents.sse.ts"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@zodios/core": "^10.0.0",
    "jose": "^6.0.0",
    "react-router": "^7.0.0",
    "sonner": "^2.0.0",
    "zod": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "openapi-zod-client": "^1.18.3",
    "react": "^19.0.0",
    "@types/react": "^19.0.0"
  },
  "dependencies": {
    "axios": "^1.19.0"
  }
}
